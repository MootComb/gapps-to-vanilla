#!/sbin/sh

OUTFD=$2
ZIPFILE=$3

LOG_FILE="/tmp/gapps-to-vanilla.log"

log() {
    echo "$(date '+%H:%M:%S') $1" >> $LOG_FILE
}

ui_print() {
    echo -n -e "ui_print $1\n" >> /proc/self/fd/$OUTFD
    echo -n -e "ui_print\n" >> /proc/self/fd/$OUTFD
    log "UI: $1"
}

abort() {
    ui_print " "
    ui_print "ERROR: $1"
    log "ABORT: $1"
    ui_print " "
    ui_print "Installation aborted"
    ui_print "Log saved to /tmp/gapps-to-vanilla.log"
    exit 1
}

echo "=========================================" > $LOG_FILE
echo "gapps-to-vanilla installation log" >> $LOG_FILE
echo "Started: $(date)" >> $LOG_FILE
echo "=========================================" >> $LOG_FILE

ui_print "========================================="
ui_print "   gapps-to-vanilla"
ui_print "   Remove GAPPS and restore AOSP"
ui_print "========================================="
ui_print " "

log "========== PARTITION DETECTION =========="

get_mount_point() {
    local path="$1"
    if mount | grep -q " $path "; then
        echo "$path"
        return 0
    fi
    local current="$path"
    while [ "$current" != "/" ] && [ "$current" != "." ]; do
        current=$(dirname "$current")
        if mount | grep -q " $current "; then
            echo "$current"
            return 0
        fi
    done
    echo ""
    return 1
}

get_device() {
    local path="$1"
    mount | grep " $path " | awk '{print $1}'
}

find_system() {
    if [ -d "/system_root/system" ] && [ -d "/system_root/system/app" ]; then
        echo "/system_root/system"
        return 0
    fi
    if [ -d "/system_root" ] && [ -d "/system_root/app" ]; then
        echo "/system_root"
        return 0
    fi
    if [ -d "/system" ] && [ -d "/system/app" ]; then
        echo "/system"
        return 0
    fi
    if [ -d "/mnt/system" ] && [ -d "/mnt/system/app" ]; then
        echo "/mnt/system"
        return 0
    fi
    echo ""
    return 1
}

find_product() {
    if [ -d "/system_root/product" ] && [ -d "/system_root/product/app" ]; then
        echo "/system_root/product"
        return 0
    fi
    if [ -d "/product" ] && [ -d "/product/app" ]; then
        echo "/product"
        return 0
    fi
    if [ -d "/system/product" ] && [ -d "/system/product/app" ]; then
        echo "/system/product"
        return 0
    fi
    echo ""
    return 1
}

find_system_ext() {
    if [ -d "/system_root/system_ext" ] && [ -d "/system_root/system_ext/app" ]; then
        echo "/system_root/system_ext"
        return 0
    fi
    if [ -d "/system_root/system/system_ext" ] && [ -d "/system_root/system/system_ext/app" ]; then
        echo "/system_root/system/system_ext"
        return 0
    fi
    if [ -d "/system_ext" ] && [ -d "/system_ext/app" ]; then
        echo "/system_ext"
        return 0
    fi
    if [ -d "/system/system_ext" ] && [ -d "/system/system_ext/app" ]; then
        echo "/system/system_ext"
        return 0
    fi
    echo ""
    return 1
}

find_vendor() {
    if [ -d "/system_root/vendor" ]; then
        echo "/system_root/vendor"
        return 0
    fi
    if [ -d "/vendor" ]; then
        echo "/vendor"
        return 0
    fi
    if [ -d "/system/vendor" ]; then
        echo "/system/vendor"
        return 0
    fi
    echo ""
    return 1
}

find_odm() {
    if [ -d "/system_root/odm" ]; then
        echo "/system_root/odm"
        return 0
    fi
    if [ -d "/odm" ]; then
        echo "/odm"
        return 0
    fi
    if [ -d "/system/odm" ]; then
        echo "/system/odm"
        return 0
    fi
    echo ""
    return 1
}

SYSTEM_PATH=$(find_system)
PRODUCT_PATH=$(find_product)
SYSTEM_EXT_PATH=$(find_system_ext)
VENDOR_PATH=$(find_vendor)
ODM_PATH=$(find_odm)

if [ -z "$SYSTEM_PATH" ]; then
    abort "Cannot find system partition"
fi

REAL_SYSTEM="$SYSTEM_PATH"
REAL_PRODUCT="$PRODUCT_PATH"
REAL_SYSTEM_EXT="$SYSTEM_EXT_PATH"
REAL_VENDOR="$VENDOR_PATH"
REAL_ODM="$ODM_PATH"

log "REAL_SYSTEM: $REAL_SYSTEM"
log "REAL_PRODUCT: $REAL_PRODUCT"
log "REAL_SYSTEM_EXT: $REAL_SYSTEM_EXT"
log "REAL_VENDOR: $REAL_VENDOR"
log "REAL_ODM: $REAL_ODM"

ui_print "Found system: $REAL_SYSTEM"
[ -n "$REAL_PRODUCT" ] && ui_print "Found product: $REAL_PRODUCT"
[ -n "$REAL_SYSTEM_EXT" ] && ui_print "Found system_ext: $REAL_SYSTEM_EXT"

ui_print " "
ui_print "Step 1/5: Mounting partitions RW"
log "Step 1/5: Mounting partitions RW"

is_rw() {
    mount | grep " $1 " | grep -q 'rw,'
}

mount_rw() {
    local path="$1"
    local mount_point=$(get_mount_point "$path")
    
    if [ -z "$mount_point" ]; then
        log "Cannot find mount point for: $path"
        return 1
    fi
    
    log "Mount point: $mount_point"
    
    if is_rw "$mount_point"; then
        log "$mount_point already RW"
        return 0
    fi
    
    local device=$(get_device "$mount_point")
    if [ -z "$device" ]; then
        log "Cannot get device for: $mount_point"
        return 1
    fi
    
    log "Device: $device"
    
    mount -o rw,remount "$device" "$mount_point" 2>/dev/null
    if is_rw "$mount_point"; then
        log "RW mounted via device"
        return 0
    fi
    
    mount -o remount,rw "$mount_point" 2>/dev/null
    if is_rw "$mount_point"; then
        log "RW mounted via mount point"
        return 0
    fi
    
    if [ "$mount_point" = "/" ] || [ "$mount_point" = "/system_root" ]; then
        mount -o rw,remount / 2>/dev/null
        if is_rw "$mount_point"; then
            log "RW mounted via root"
            return 0
        fi
    fi
    
    log "Failed to mount RW for $mount_point"
    return 1
}

MOUNT_POINTS=""

for path in "$REAL_SYSTEM" "$REAL_PRODUCT" "$REAL_SYSTEM_EXT" "$REAL_VENDOR" "$REAL_ODM"; do
    if [ -n "$path" ] && [ -d "$path" ]; then
        mp=$(get_mount_point "$path")
        if [ -n "$mp" ] && [ "$mp" != "/" ]; then
            MOUNT_POINTS="$MOUNT_POINTS $mp"
            log "Will mount: $mp"
        fi
    fi
done

MOUNT_POINTS=$(echo "$MOUNT_POINTS" | tr ' ' '\n' | sort -u | tr '\n' ' ')
log "Unique mount points: $MOUNT_POINTS"

for point in $MOUNT_POINTS; do
    [ -z "$point" ] && continue
    ui_print "  -> $point"
    if mount_rw "$point"; then
        ui_print "    [OK] $point writable"
    else
        ui_print "    [WARN] $point still RO"
    fi
done

if ! touch "$REAL_SYSTEM/test_write" 2>/dev/null; then
    ui_print "  [WARN] System not writable, attempting force remount"
    mount -o rw,remount / 2>/dev/null
    mount -o rw,remount /system_root 2>/dev/null
    mount -o rw,remount /system 2>/dev/null
fi
rm -f "$REAL_SYSTEM/test_write" 2>/dev/null

log ""
log "Step 2/5: Checking free space"
ui_print " "
ui_print "Step 2/5: Checking free space"

for point in $MOUNT_POINTS; do
    if [ -n "$point" ] && [ -d "$point" ]; then
        FREE=$(df -k "$point" 2>/dev/null | tail -1 | awk '{print $4}')
        if [ -n "$FREE" ]; then
            ui_print "  -> $point: ${FREE}KB free"
            log "$point: ${FREE}KB free"
        fi
    fi
done

log ""
log "Step 3/5: Removing GAPPS files"
ui_print " "
ui_print "Step 3/5: Removing GAPPS files"

TMPDIR=/tmp/gapps_to_vanilla
rm -rf $TMPDIR
mkdir -p $TMPDIR
cd $TMPDIR

unzip -o "$ZIPFILE" 'delete.list' -d . > /dev/null 2>&1

if [ ! -f "delete.list" ]; then
    log "delete.list not found"
    ui_print "WARNING: delete.list not found"
    touch /tmp/delete.list
else
    cp delete.list /tmp/delete.list
    DELETE_COUNT=$(wc -l < /tmp/delete.list)
    log "Found $DELETE_COUNT items to remove"
    ui_print "Found $DELETE_COUNT items to remove"
fi

delete_item() {
    local target="$1"
    local clean="${target#/}"
    
    local bases="
        $REAL_SYSTEM
        $REAL_PRODUCT
        $REAL_SYSTEM_EXT
        $REAL_VENDOR
        $REAL_ODM
    "
    
    for base in $bases; do
        [ -z "$base" ] && continue
        [ ! -d "$base" ] && continue
        
        local path="$base/$clean"
        path=$(echo "$path" | sed 's|//*|/|g')
        
        if [ -d "$path" ]; then
            log "Found dir: $path"
            rm -rf "$path" 2>/dev/null
            if [ ! -d "$path" ]; then
                log "Deleted dir: $path"
                return 2
            fi
        elif [ -f "$path" ]; then
            log "Found file: $path"
            rm -f "$path" 2>/dev/null
            if [ ! -f "$path" ]; then
                log "Deleted file: $path"
                return 1
            fi
        fi
    done
    
    log "Not found: $target"
    return 0
}

DELETED_FILES=0
DELETED_DIRS=0
NOT_FOUND=0

if [ -s "/tmp/delete.list" ]; then
    while IFS= read -r path; do
        [ -z "$path" ] && continue
        delete_item "$path"
        case $? in
            1) DELETED_FILES=$((DELETED_FILES + 1)) ;;
            2) DELETED_DIRS=$((DELETED_DIRS + 1)) ;;
            *) NOT_FOUND=$((NOT_FOUND + 1)) ;;
        esac
    done < "/tmp/delete.list"
    
    log "Files deleted: $DELETED_FILES, Dirs deleted: $DELETED_DIRS, Not found: $NOT_FOUND"
    ui_print " "
    ui_print "Summary:"
    ui_print "  Files deleted: $DELETED_FILES"
    ui_print "  Directories deleted: $DELETED_DIRS"
    [ $NOT_FOUND -gt 0 ] && ui_print "  Not found: $NOT_FOUND"
else
    log "Nothing to remove"
    ui_print "Nothing to remove"
fi

log ""
log "Step 4/5: Restoring VANILLA files"
ui_print " "
ui_print "Step 4/5: Restoring VANILLA files"

cd $TMPDIR

unzip -o "$ZIPFILE" -d . > /dev/null 2>&1

log "Extracted contents:"
for dir in system system_ext product vendor odm; do
    if [ -d "$dir" ]; then
        COUNT=$(find "$dir" -type f 2>/dev/null | wc -l)
        log "$dir: $COUNT files"
        ui_print "Extracted $dir: $COUNT files"
    else
        log "$dir: not found in ZIP"
    fi
done

TOTAL_RESTORED=0
TOTAL_FAILED=0

restore_dir() {
    local src_dir="$1"
    local name="$2"
    
    if [ ! -d "$src_dir" ]; then
        log "SKIP $name - source not found"
        return 0
    fi
    
    local target_base=""
    case "$name" in
        system) target_base="$REAL_SYSTEM" ;;
        product) target_base="$REAL_PRODUCT" ;;
        system_ext) target_base="$REAL_SYSTEM_EXT" ;;
        vendor) target_base="$REAL_VENDOR" ;;
        odm) target_base="$REAL_ODM" ;;
    esac
    
    if [ -z "$target_base" ] || [ ! -d "$target_base" ]; then
        log "SKIP $name - target not found: $target_base"
        return 0
    fi
    
    log "Restoring $name to $target_base"
    ui_print "Restoring $name to $target_base"
    
    cd "$src_dir"
    find . -type f 2>/dev/null | while read -r file; do
        dest="$target_base/${file#./}"
        dest_dir=$(dirname "$dest")
        mkdir -p "$dest_dir" 2>/dev/null
        if cp -f "$file" "$dest" 2>/dev/null; then
            chmod 644 "$dest" 2>/dev/null
            chcon --reference="$src_dir/${file#./}" "$dest" 2>/dev/null
            echo "OK" >> /tmp/restore_status.txt
        else
            log "FAILED: ${file#./}"
            echo "FAIL" >> /tmp/restore_status.txt
        fi
    done
    
    if [ -f /tmp/restore_status.txt ]; then
        ok=$(grep -c 'OK' /tmp/restore_status.txt 2>/dev/null || echo 0)
        fail=$(grep -c 'FAIL' /tmp/restore_status.txt 2>/dev/null || echo 0)
        TOTAL_RESTORED=$((TOTAL_RESTORED + ok))
        TOTAL_FAILED=$((TOTAL_FAILED + fail))
        rm -f /tmp/restore_status.txt
        log "$name: $ok restored, $fail failed"
        ui_print "$name: $ok restored, $fail failed"
    fi
    
    cd /
}

if [ -d "$TMPDIR/system" ]; then
    restore_dir "$TMPDIR/system" "system"
fi

if [ -d "$TMPDIR/product" ]; then
    restore_dir "$TMPDIR/product" "product"
fi

if [ -d "$TMPDIR/system_ext" ]; then
    restore_dir "$TMPDIR/system_ext" "system_ext"
fi

if [ -d "$TMPDIR/vendor" ]; then
    restore_dir "$TMPDIR/vendor" "vendor"
fi

if [ -d "$TMPDIR/odm" ]; then
    restore_dir "$TMPDIR/odm" "odm"
fi

log ""
log "Step 5/5: Cleanup"
ui_print " "
ui_print "Step 5/5: Cleanup"

rm -rf /tmp/gapps_to_vanilla /tmp/delete.list /tmp/restore_status.txt

log ""
log "========================================="
log "Installation complete"
log "Files restored: $TOTAL_RESTORED"
log "Files failed: $TOTAL_FAILED"
log "GAPPS deleted: $((DELETED_FILES + DELETED_DIRS))"
log "========================================="

ui_print " "
ui_print "========================================="
ui_print "Installation complete"
ui_print " "
ui_print "GAPPS removed, VANILLA AOSP restored"
ui_print " "
ui_print "Log saved: /tmp/gapps-to-vanilla.log"
ui_print "========================================="
ui_print " "

exit 0
