#!/sbin/sh

OUTFD=$2
ZIPFILE=$3

FORCE_ACTION=2

LOG_FILE="/tmp/gapps-to-vanilla.log"

log() {
    echo "$(date '+%H:%M:%S') $1" >> "$LOG_FILE"
}

ui_print() {
    if [ -n "$OUTFD" ] && [ -e "/proc/self/fd/$OUTFD" ]; then
        echo -n -e "ui_print $1\n" >> "/proc/self/fd/$OUTFD"
        echo -n -e "ui_print\n" >> "/proc/self/fd/$OUTFD"
    fi
    log "UI: $1"
}

abort() {
    ui_print " "
    ui_print "ERROR: $1"
    log "ABORT: $1"
    ui_print " "
    ui_print "Installation aborted"
    ui_print "Log saved to $LOG_FILE"
    exit 1
}

is_symlink() { [ -L "$1" ]; }

is_rw() {
    awk -v mp="$1" '$3==mp && $4 ~ /^rw/ {found=1} END{exit !found}' /proc/mounts
}

get_device() {
    awk -v mp="$1" '$3==mp {print $1; exit}' /proc/mounts
}

get_fstype() {
    awk -v mp="$1" '$3==mp {print $5; exit}' /proc/mounts
}

# Remount a given mount point (or the nearest ancestor that IS a mount point) to RW.
mount_rw() {
    local path="$1"
    local mp="$path"

    if ! awk -v m="$mp" '$3==m {found=1} END{exit !found}' /proc/mounts; then
        local cur="$path"
        mp=""
        while [ -n "$cur" ] && [ "$cur" != "/" ]; do
            if awk -v m="$cur" '$3==m {found=1} END{exit !found}' /proc/mounts; then
                mp="$cur"; break
            fi
            cur=$(dirname "$cur")
        done
        [ -z "$mp" ] && { log "No mount point for $path"; return 1; }
    fi

    if is_rw "$mp"; then
        log "$mp already RW"
        return 0
    fi

    local dev
    dev=$(get_device "$mp")

    [ -n "$dev" ] && mount -o rw,remount "$dev" "$mp" 2>/dev/null
    is_rw "$mp" && { log "$mp RW via device ($dev)"; return 0; }

    mount -o remount,rw "$mp" 2>/dev/null
    is_rw "$mp" && { log "$mp RW via mount point"; return 0; }

    log "Failed to remount $mp RW"
    return 1
}

# Find a partition: FIRST look at real mount points in /proc/mounts,
# THEN fall back to directory probing.
find_partition() {
    local name="$1"
    log "Searching for $name partition..."

    local mp=""
    case "$name" in
        system)
            mp=$(awk '$3=="/system_root" || $3=="/system" || $3=="/mnt/system" {print $3; exit}' /proc/mounts)
            ;;
        product)
            mp=$(awk '$3=="/product" || $3=="/system/product" || $3=="/system_root/system/product" {print $3; exit}' /proc/mounts)
            ;;
        system_ext)
            mp=$(awk '$3=="/system_ext" || $3=="/system/system_ext" || $3=="/system_root/system/system_ext" {print $3; exit}' /proc/mounts)
            ;;
    esac

    if [ -n "$mp" ] && [ -d "$mp" ]; then
        log "Found $name at mount point $mp"
        echo "$mp"
        return 0
    fi

    local candidates=""
    case "$name" in
        system)     candidates="/system_root/system /system_root /system /mnt/system" ;;
        product)    candidates="/product /system/product /system_root/system/product" ;;
        system_ext) candidates="/system_ext /system/system_ext /system_root/system/system_ext" ;;
    esac

    local c
    for c in $candidates; do
        [ -d "$c" ] || continue
        if [ "$name" = "system" ]; then
            [ -f "$c/build.prop" ] || continue
        else
            [ -d "$c/app" ] || [ -d "$c/priv-app" ] || continue
        fi
        log "Found $name at $c"
        echo "$c"
        return 0
    done

    log "$name partition not found"
    return 1
}

# ---------------------------------------------------------------------------
# Start
# ---------------------------------------------------------------------------

echo "=========================================" > "$LOG_FILE"
echo "gapps-to-vanilla installation log" >> "$LOG_FILE"
echo "Started: $(date)" >> "$LOG_FILE"
echo "=========================================" >> "$LOG_FILE"

ui_print "========================================="
ui_print "   gapps-to-vanilla"
ui_print "   Remove GAPPS and restore AOSP"
ui_print "========================================="
ui_print " "

# Mode selection
INSTALL_MODE=1
case "$FORCE_ACTION" in
    0)
        if check_volume_keys 2>/dev/null; then INSTALL_MODE=0; else INSTALL_MODE=1; fi
        ;;
    1) INSTALL_MODE=0 ;;
    2) INSTALL_MODE=1 ;;
    *) INSTALL_MODE=0 ;;
esac
log "Installation mode: $INSTALL_MODE (0=Full, 1=Minimal)"
ui_print "Forced mode: $([ $INSTALL_MODE -eq 0 ] && echo 'Full restore' || echo 'Minimal restore')"
ui_print " "

# ---------------------------------------------------------------------------
# Partition detection
# ---------------------------------------------------------------------------
log "========== PARTITION DETECTION =========="
SYSTEM_PATH=$(find_partition system)
PRODUCT_PATH=$(find_partition product)
SYSTEM_EXT_PATH=$(find_partition system_ext)

[ -z "$SYSTEM_PATH" ] && abort "Cannot find system partition"

REAL_SYSTEM="$SYSTEM_PATH"
REAL_PRODUCT="$PRODUCT_PATH"
REAL_SYSTEM_EXT="$SYSTEM_EXT_PATH"

log "Final partition paths:"
log "  REAL_SYSTEM:     $REAL_SYSTEM"
log "  REAL_PRODUCT:    ${REAL_PRODUCT:-(none)}"
log "  REAL_SYSTEM_EXT: ${REAL_SYSTEM_EXT:-(none)}"

ui_print "Found partitions:"
ui_print "  System:     $REAL_SYSTEM"
[ -n "$REAL_PRODUCT" ]    && ui_print "  Product:    $REAL_PRODUCT"
[ -n "$REAL_SYSTEM_EXT" ] && ui_print "  System_ext: $REAL_SYSTEM_EXT"
ui_print " "

# ---------------------------------------------------------------------------
# Step 1: mount RW
# ---------------------------------------------------------------------------
ui_print "Step 1/5: Mounting partitions RW"
log "Step 1/5: Mounting partitions RW"

RW_OK=0
for p in "$REAL_SYSTEM" "$REAL_PRODUCT" "$REAL_SYSTEM_EXT"; do
    [ -n "$p" ] && [ -d "$p" ] || continue
    ui_print "  Mounting: $p"
    if mount_rw "$p"; then
        ui_print "    [OK] $p writable"
        RW_OK=$((RW_OK + 1))
    else
        ui_print "    [WARN] $p still RO"
    fi
done

ui_print " "
ui_print "Checking writability..."

CAN_WRITE=0
for base in "$REAL_SYSTEM" "$REAL_PRODUCT" "$REAL_SYSTEM_EXT"; do
    [ -n "$base" ] && [ -d "$base" ] || continue
    tf="$base/.g2v_rw_test"
    if touch "$tf" 2>/dev/null; then
        rm -f "$tf" 2>/dev/null
        fs=$(get_fstype "$base")
        log "WRITABLE: $base (fstype=${fs:-unknown})"
        ui_print "  [RW] $base (${fs:-unknown})"
        CAN_WRITE=$((CAN_WRITE + 1))
    else
        fs=$(get_fstype "$base")
        log "READ-ONLY: $base (fstype=${fs:-unknown})"
        ui_print "  [RO] $base (${fs:-unknown})"
    fi
done

if [ $CAN_WRITE -eq 0 ]; then
    abort "All target partitions are READ-ONLY. Cannot modify."
fi

# ---------------------------------------------------------------------------
# Step 2: free space
# ---------------------------------------------------------------------------
ui_print " "
ui_print "Step 2/5: Checking free space"
log "Step 2/5: Checking free space"

for mp in "$REAL_SYSTEM" "$REAL_PRODUCT" "$REAL_SYSTEM_EXT"; do
    [ -n "$mp" ] && [ -d "$mp" ] || continue
    FREE=$(df -k "$mp" 2>/dev/null | tail -1 | awk '{print $4}')
    [ -n "$FREE" ] && { ui_print "  -> $mp: ${FREE}KB free"; log "$mp: ${FREE}KB free"; }
done

# ---------------------------------------------------------------------------
# Step 3: remove GAPPS
# ---------------------------------------------------------------------------
ui_print " "
ui_print "Step 3/5: Removing GAPPS files"
log "Step 3/5: Removing GAPPS files"

TMPDIR=/tmp/gapps_to_vanilla
rm -rf "$TMPDIR"
mkdir -p "$TMPDIR"
cd "$TMPDIR" || abort "Cannot cd to $TMPDIR"

unzip -o "$ZIPFILE" 'delete.list' -d . > /dev/null 2>&1

if [ ! -f "delete.list" ]; then
    log "delete.list not found in ZIP"
    ui_print "WARNING: delete.list not found"
    : > /tmp/delete.list
else
    cp delete.list /tmp/delete.list
    DELETE_COUNT=$(wc -l < /tmp/delete.list | tr -d ' ')
    log "Found $DELETE_COUNT items to remove"
    ui_print "Found $DELETE_COUNT items to remove"
fi

DELETE_LOG="/tmp/deleted_files.log"
: > "$DELETE_LOG"

delete_item() {
    local target="$1"
    local clean="${target#/}"
    local found=0 deleted=0 failed=0

    for base in "$REAL_SYSTEM" "$REAL_PRODUCT" "$REAL_SYSTEM_EXT"; do
        [ -n "$base" ] && [ -d "$base" ] || continue
        local path="$base/$clean"
        path=$(echo "$path" | sed 's|//*|/|g')

        if [ -e "$path" ] && ! is_symlink "$path"; then
            found=1
            log "DELETING: $path"
            echo "TRY: $path" >> "$DELETE_LOG"
            rm -rf "$path" 2>>"$LOG_FILE"
            if [ ! -e "$path" ]; then
                log "SUCCESS: Deleted: $path"
                echo "OK: $path" >> "$DELETE_LOG"
                deleted=1
            else
                log "FAILED: path still exists: $path"
                echo "FAIL: $path" >> "$DELETE_LOG"
                failed=1
            fi
        fi
    done

    if [ $found -eq 0 ]; then
        log "NOT FOUND: $target"
        echo "NOT_FOUND: $target" >> "$DELETE_LOG"
        return 0
    fi
    [ $failed -eq 1 ] && return 2
    [ $deleted -eq 1 ] && return 1
    return 0
}

DELETED_FILES=0
NOT_FOUND=0
DELETE_FAILED=0

if [ -s "/tmp/delete.list" ]; then
    while IFS= read -r path; do
        [ -z "$path" ] && continue
        delete_item "$path"
        case $? in
            1) DELETED_FILES=$((DELETED_FILES + 1)) ;;
            2) DELETE_FAILED=$((DELETE_FAILED + 1)) ;;
            *) NOT_FOUND=$((NOT_FOUND + 1)) ;;
        esac
    done < "/tmp/delete.list"

    log "DELETION SUMMARY: deleted=$DELETED_FILES failed=$DELETE_FAILED notfound=$NOT_FOUND"
    ui_print "Removal Summary:"
    ui_print "  Files deleted: $DELETED_FILES"
    [ $DELETE_FAILED -gt 0 ] && ui_print "  Failed to delete: $DELETE_FAILED"
    [ $NOT_FOUND -gt 0 ] && ui_print "  Not found: $NOT_FOUND"
else
    log "Nothing to remove"
    ui_print "Nothing to remove"
fi

# ---------------------------------------------------------------------------
# App lists
# ---------------------------------------------------------------------------

# Apps to remove from target partitions (real Google extras we don't want)
EXTRA_APPS_LIST="
priv-app/LineageSetupWizard
priv-app/GoogleDialer
priv-app/PrebuiltBugle
priv-app/PrebuiltDeskClockGoogle_76007351
priv-app/SoundPicker
"

# Files to exclude from the vanilla RESTORE set only.
# We must NOT overwrite these on the target: their signatures differ from
# the GSI versions already installed, which causes
# "Signature mismatch" bootloop (observed: me.phh.treble.app).
# But we also must NOT delete them from the target, since they are part
# of the GSI itself.
REMOVE_FROM_RESTORE_ONLY="
priv-app/TrebleApp/TrebleApp.apk
priv-app/PackageInstaller/PackageInstaller.apk
app/PrintRecommendationService/PrintRecommendationService.apk
app/ExtShared/ExtShared.apk
apex/com.android.virt.apex
etc/NOTICE.xml.gz
"

remove_extra_apps_from_target() {
    log "Removing extra Google apps from target partitions..."
    ui_print "Removing extra Google apps..."
    local app base path
    for app in $EXTRA_APPS_LIST; do
        [ -z "$app" ] && continue
        for base in "$REAL_SYSTEM" "$REAL_PRODUCT" "$REAL_SYSTEM_EXT"; do
            [ -n "$base" ] && [ -d "$base" ] || continue
            path="$base/$app"
            if [ -e "$path" ] && ! is_symlink "$path"; then
                log "DELETING EXTRA APP: $path"
                rm -rf "$path" 2>>"$LOG_FILE"
                if [ ! -e "$path" ]; then
                    log "SUCCESS: Deleted extra app: $path"
                    ui_print "  Deleted: $path"
                else
                    log "FAILED: Could not delete extra app: $path"
                    DELETE_FAILED=$((DELETE_FAILED + 1))
                fi
            fi
        done
    done
}

if [ $INSTALL_MODE -eq 1 ]; then
    ui_print " "
    remove_extra_apps_from_target
fi

# ---------------------------------------------------------------------------
# Step 4: restore VANILLA
# ---------------------------------------------------------------------------
ui_print " "
ui_print "Step 4/5: Restoring VANILLA files"
log "Step 4/5: Restoring VANILLA files"

cd "$TMPDIR" || abort "Cannot cd to $TMPDIR"
unzip -o "$ZIPFILE" -d . > /dev/null 2>&1

# ---------------------------------------------------------------------------
# Filter out non-GApps system files from the restore set.
# These are part of the GSI and already carry the correct signatures.
# Overwriting them with vanilla-zip versions causes "Signature mismatch"
# on boot (observed: me.phh.treble.app in shared user android.uid.system).
# ---------------------------------------------------------------------------
log "Filtering non-GApps files from restore set..."
for f in $REMOVE_FROM_RESTORE_ONLY; do
    for part in system product system_ext; do
        target="$TMPDIR/$part/$f"
        if [ -e "$target" ]; then
            rm -f "$target"
            log "Removed from restore (keep GSI version): $part/$f"
        fi
    done
done

if [ $INSTALL_MODE -eq 1 ]; then
    log "Removing extra apps from restore files..."
    ui_print "Removing extra apps from restore..."
    for app in $EXTRA_APPS_LIST; do
        for part in system product system_ext; do
            d="$TMPDIR/$part/$app"
            [ -d "$d" ] && rm -rf "$d" && log "Removed from restore: $d"
        done
    done
fi

log "Extracted contents:"
for part in system system_ext product; do
    if [ -d "$TMPDIR/$part" ]; then
        COUNT=$(find "$TMPDIR/$part" -type f 2>/dev/null | wc -l | tr -d ' ')
        log "  $part: $COUNT files"
        ui_print "Extracted $part: $COUNT files"
    else
        log "  $part: not found in ZIP"
    fi
done

RESTORE_LOG="/tmp/restored_files.log"
: > "$RESTORE_LOG"

restore_dir() {
    local src_dir="$1"
    local target_base="$2"
    local name="$3"

    if [ ! -d "$src_dir" ] || [ -z "$target_base" ] || [ ! -d "$target_base" ]; then
        log "SKIP $name (src or target missing)"
        return 0
    fi

    log "RESTORING $name -> $target_base"
    ui_print "Restoring $name to $target_base"

    local status_file="/tmp/restore_status_$name.txt"
    : > "$status_file"

    local filelist="/tmp/restore_filelist_$name.txt"
    ( cd "$src_dir" && find . -type f ) > "$filelist" 2>/dev/null

    local file rel dest dest_dir
    while IFS= read -r file; do
        [ -z "$file" ] && continue
        rel="${file#./}"
        dest="$target_base/$rel"
        dest_dir=$(dirname "$dest")

        if [ ! -d "$dest_dir" ]; then
            mkdir -p "$dest_dir" 2>>"$LOG_FILE"
            if [ ! -d "$dest_dir" ]; then
                log "FAILED mkdir: $dest_dir"
                echo "FAIL: $dest" >> "$RESTORE_LOG"
                echo "FAIL" >> "$status_file"
                continue
            fi
        fi

        cp -f "$src_dir/$rel" "$dest" 2>>"$LOG_FILE"
        if [ $? -eq 0 ] && [ -f "$dest" ]; then
            chmod 644 "$dest" 2>/dev/null
            chown root:root "$dest" 2>/dev/null
            chcon --reference="$src_dir/$rel" "$dest" 2>/dev/null || true
            log "RESTORED: $dest"
            echo "OK: $dest" >> "$RESTORE_LOG"
            echo "OK" >> "$status_file"
        else
            log "FAILED cp: $rel -> $dest"
            echo "FAIL: $dest" >> "$RESTORE_LOG"
            echo "FAIL" >> "$status_file"
        fi
    done < "$filelist"

    rm -f "$filelist"

    local ok fail
    ok=$(grep -c '^OK$' "$status_file" 2>/dev/null || echo 0)
    fail=$(grep -c '^FAIL$' "$status_file" 2>/dev/null || echo 0)
    log "$name SUMMARY: $ok restored, $fail failed"
    ui_print "$name: $ok restored, $fail failed"

    RESTORED_TOTAL=$((RESTORED_TOTAL + ok))
    FAILED_TOTAL=$((FAILED_TOTAL + fail))

    rm -f "$status_file"
    return 0
}

RESTORED_TOTAL=0
FAILED_TOTAL=0

[ -d "$TMPDIR/system" ]     && restore_dir "$TMPDIR/system"     "$REAL_SYSTEM"     "system"
[ -d "$TMPDIR/product" ]    && restore_dir "$TMPDIR/product"    "$REAL_PRODUCT"    "product"
[ -d "$TMPDIR/system_ext" ] && restore_dir "$TMPDIR/system_ext" "$REAL_SYSTEM_EXT" "system_ext"

if [ $INSTALL_MODE -eq 1 ]; then
    log "Final cleanup of extra apps on target..."
    ui_print "Final cleanup of extra apps..."
    remove_extra_apps_from_target
fi

# ---------------------------------------------------------------------------
# Step 5: cleanup + remount back to RO
# ---------------------------------------------------------------------------
ui_print " "
ui_print "Step 5/5: Cleanup"
log "Step 5/5: Cleanup"

cp "$DELETE_LOG" "/tmp/gapps-deleted.log" 2>/dev/null
cp "$RESTORE_LOG" "/tmp/gapps-restored.log" 2>/dev/null

rm -rf "$TMPDIR"
rm -f /tmp/delete.list /tmp/restore_status*.txt "$DELETE_LOG" "$RESTORE_LOG"

log ""
log "========================================="
log "Installation complete"
log "Mode: $([ $INSTALL_MODE -eq 0 ] && echo 'Full restore' || echo 'Minimal restore')"
log "Files restored: $RESTORED_TOTAL"
log "Files failed:   $FAILED_TOTAL"
log "GAPPS deleted:  $DELETED_FILES"
log "GAPPS failed:   $DELETE_FAILED"
log "========================================="
log "  - /tmp/gapps-deleted.log"
log "  - /tmp/gapps-restored.log"
log "========================================="

ui_print " "
ui_print "========================================="
ui_print "Installation complete"
ui_print "Mode: $([ $INSTALL_MODE -eq 0 ] && echo 'Full restore' || echo 'Minimal restore')"
ui_print " "
ui_print "Summary:"
ui_print "  Restored: $RESTORED_TOTAL files"
[ $FAILED_TOTAL -gt 0 ] && ui_print "  Failed to restore: $FAILED_TOTAL files"
ui_print "  GAPPS deleted: $DELETED_FILES"
[ $DELETE_FAILED -gt 0 ] && ui_print "  GAPPS delete failed: $DELETE_FAILED"
ui_print " "
ui_print "Log saved: $LOG_FILE"
ui_print "========================================="

# Return product/system_ext to RO to avoid verity issues on reboot.
log "Remounting product/system_ext back to RO..."
for p in "$REAL_PRODUCT" "$REAL_SYSTEM_EXT"; do
    [ -n "$p" ] && [ -d "$p" ] || continue
    mount -o remount,ro "$p" 2>/dev/null || true
done
sync

if [ $FAILED_TOTAL -gt 0 ] || [ $DELETE_FAILED -gt 0 ]; then
    log "WARNING: Some operations failed. Check logs."
fi

exit 0
