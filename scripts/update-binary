#!/sbin/sh
#
# gapps-to-vanilla
# Remove GAPPS and restore AOSP files
#

OUTFD=$2
ZIPFILE=$3

LOG_FILE="/tmp/gapps-to-vanilla.log"

log() {
    echo "$(date '+%H:%M:%S') $1" >> $LOG_FILE
}

ui_print() {
    echo -n -e "ui_print $1\n" >> /proc/self/fd/$OUTFD
    echo -n -e "ui_print\n" >> /proc/self/fd/$OUTFD
    log "UI: $1"
}

abort() {
    ui_print " "
    ui_print "ERROR: $1"
    log "ABORT: $1"
    ui_print " "
    ui_print "Installation aborted"
    ui_print "Log saved to /tmp/gapps-to-vanilla.log"
    exit 1
}

# Initialize log
echo "=========================================" > $LOG_FILE
echo "gapps-to-vanilla installation log" >> $LOG_FILE
echo "Started: $(date)" >> $LOG_FILE
echo "=========================================" >> $LOG_FILE

ui_print "========================================="
ui_print "   gapps-to-vanilla"
ui_print "   Remove GAPPS and restore AOSP"
ui_print "========================================="
ui_print " "

log "Detecting partition layout..."

# Check all possible mount points
FOUND_SYSTEM=""
FOUND_PRODUCT=""
FOUND_SYSTEM_EXT=""
SYSTEM_ROOT_MOUNT=""

# Check /system_root first (OrangeFox, some TWRP)
if [ -d "/system_root/system" ] && [ -d "/system_root/system/app" ]; then
    FOUND_SYSTEM="/system_root/system"
    SYSTEM_ROOT_MOUNT="/system_root"
    log "  Found /system_root/system (system_root layout)"

# Check /system (standard)
elif [ -d "/system/app" ] || [ -d "/system/bin" ]; then
    FOUND_SYSTEM="/system"
    log "  Found /system (standard layout)"

# Check if /system is symlink to /system_root/system
elif [ -L "/system" ]; then
    REAL_SYSTEM=$(readlink -f /system)
    if [ -d "$REAL_SYSTEM/app" ]; then
        FOUND_SYSTEM="$REAL_SYSTEM"
        SYSTEM_ROOT_MOUNT=$(dirname "$REAL_SYSTEM")
        log "  /system is symlink to $REAL_SYSTEM"
        log "  Using $FOUND_SYSTEM, root at $SYSTEM_ROOT_MOUNT"
    fi
fi

# Check /product
if [ -d "/product/app" ] || [ -d "/product/bin" ]; then
    FOUND_PRODUCT="/product"
    log "  Found /product"
elif [ -L "/product" ]; then
    FOUND_PRODUCT=$(readlink -f /product)
    log "  /product is symlink to $FOUND_PRODUCT"
fi

# Check /system_ext
if [ -d "/system_ext/app" ] || [ -d "/system_ext/bin" ]; then
    FOUND_SYSTEM_EXT="/system_ext"
    log "  Found /system_ext"
elif [ -L "/system_ext" ]; then
    FOUND_SYSTEM_EXT=$(readlink -f /system_ext)
    log "  /system_ext is symlink to $FOUND_SYSTEM_EXT"
fi

if [ -z "$FOUND_SYSTEM" ]; then
    abort "Cannot find system partition!"
fi

log "Final mount points:"
log "  SYSTEM: $FOUND_SYSTEM"
log "  PRODUCT: $FOUND_PRODUCT"
log "  SYSTEM_EXT: $FOUND_SYSTEM_EXT"
log "  SYSTEM_ROOT: $SYSTEM_ROOT_MOUNT"

ui_print "Step 1/6: Mounting partitions"
log "Step 1/6: Mounting partitions"

# Function to mount partition as RW
mount_rw() {
    local mount_point="$1"
    local device=""
    
    # Find device for this mount point
    device=$(mount | grep " $mount_point " | awk '{print $1}')
    
    if [ -z "$device" ]; then
        # Try to find by mount point name
        device=$(mount | grep "/$(basename $mount_point) " | awk '{print $1}')
    fi
    
    if [ -n "$device" ]; then
        log "  Device for $mount_point: $device"
        
        # Check filesystem type
        FS_TYPE=$(mount | grep " $mount_point " | awk '{print $5}')
        log "  Filesystem: $FS_TYPE"
        
        # Remount as RW
        mount -o remount,rw $mount_point 2>/dev/null
        if [ $? -eq 0 ]; then
            log "  Remounted $mount_point as RW (remount)"
        else
            mount -o rw -t $FS_TYPE $device $mount_point 2>/dev/null
            if [ $? -eq 0 ]; then
                log "  Mounted $mount_point as RW (fresh mount)"
            else
                log "  WARNING: Failed to mount $mount_point as RW"
            fi
        fi
    else
        log "  No device found for $mount_point, trying direct remount"
        mount -o remount,rw $mount_point 2>/dev/null || mount -o rw $mount_point 2>/dev/null
    fi
    
    # Verify RW
    if touch $mount_point/.test_rw 2>/dev/null; then
        rm -f $mount_point/.test_rw
        log "  [OK] $mount_point is now writable"
        return 0
    else
        log "  [FAILED] $mount_point is still read-only"
        return 1
    fi
}

# Mount system_root first if exists
if [ -n "$SYSTEM_ROOT_MOUNT" ]; then
    ui_print "  -> $SYSTEM_ROOT_MOUNT (system root)"
    log "  Mounting system root: $SYSTEM_ROOT_MOUNT"
    mount_rw "$SYSTEM_ROOT_MOUNT"
    if [ $? -ne 0 ]; then
        abort "Failed to mount $SYSTEM_ROOT_MOUNT as RW"
    fi
fi

# Mount all partitions
for point in "$FOUND_SYSTEM" "$FOUND_PRODUCT" "$FOUND_SYSTEM_EXT"; do
    if [ -n "$point" ] && [ "$point" != "$SYSTEM_ROOT_MOUNT" ]; then
        ui_print "  -> $point"
        log "  Mounting: $point"
        if ! mount_rw "$point"; then
            abort "Failed to mount $point as RW"
        fi
    fi
done

log ""
log "Step 2/6: Checking free space"
ui_print " "
ui_print "Step 2/6: Checking free space"

for point in "$FOUND_SYSTEM" "$FOUND_PRODUCT" "$FOUND_SYSTEM_EXT"; do
    if [ -n "$point" ] && [ -d "$point" ]; then
        FREE=$(df -k "$point" 2>/dev/null | tail -1 | awk '{print $4}')
        if [ -n "$FREE" ]; then
            ui_print "  -> $point: ${FREE}KB free"
            log "  $point: ${FREE}KB free"
            if [ "$FREE" -lt 51200 ] 2>/dev/null; then
                ui_print "    WARNING: Low space on $point"
                log "    WARNING: Low space"
            fi
        fi
    fi
done

log ""
log "Step 3/6: Extracting delete list from ZIP"
ui_print " "
ui_print "Step 3/6: Extracting delete list from ZIP"

TMPDIR=/tmp/gapps_to_vanilla
rm -rf $TMPDIR
mkdir -p $TMPDIR
cd $TMPDIR

unzip -o "$ZIPFILE" 'delete.list' -d . > /dev/null 2>&1
if [ -f "delete.list" ]; then
    cp delete.list /tmp/delete.list
    DELETE_COUNT=$(wc -l < /tmp/delete.list)
    log "  Found $DELETE_COUNT items to remove"
    ui_print "  Found $DELETE_COUNT items to remove"
else
    touch /tmp/delete.list
    log "  WARNING: delete.list not found in ZIP!"
    ui_print "  WARNING: delete.list not found!"
fi

log ""
log "Step 4/6: Removing GAPPS files"
ui_print " "
ui_print "Step 4/6: Removing GAPPS files"

# Function to find and delete a file/directory
delete_item() {
    local target="$1"
    local found=0
    
    # List of possible base paths to search
    local bases="$FOUND_SYSTEM $FOUND_PRODUCT $FOUND_SYSTEM_EXT $SYSTEM_ROOT_MOUNT /system /system_root"
    
    for base in $bases; do
        if [ -z "$base" ]; then
            continue
        fi
        
        # Remove leading slash from target for path joining
        local clean_target="${target#/}"
        
        # Try different path combinations
        local paths_to_try="$base/$clean_target"
        
        # If target starts with /product, try replacing with system/product
        if echo "$target" | grep -q '^/product/'; then
            local sub_path="${target#/product/}"
            paths_to_try="$paths_to_try $base/product/$sub_path"
        fi
        
        # If target starts with /system_ext, try replacing with system/system_ext
        if echo "$target" | grep -q '^/system_ext/'; then
            local sub_path="${target#/system_ext/}"
            paths_to_try="$paths_to_try $base/system_ext/$sub_path"
        fi
        
        # If target starts with /system/, try without system prefix
        if echo "$target" | grep -q '^/system/'; then
            local sub_path="${target#/system/}"
            paths_to_try="$paths_to_try $base/$sub_path"
        fi
        
        for full_path in $paths_to_try; do
            if [ -d "$full_path" ]; then
                rm -rf "$full_path"
                if [ ! -d "$full_path" ]; then
                    log "  [DELETED] $full_path/ (directory)"
                    return 2
                fi
            elif [ -f "$full_path" ]; then
                rm -f "$full_path"
                if [ ! -f "$full_path" ]; then
                    log "  [DELETED] $full_path"
                    return 1
                fi
            fi
        done
    done
    
    log "  [NOT FOUND] $target (searched in: $bases)"
    return 0
}

if [ -s "/tmp/delete.list" ]; then
    DELETED_FILES=0
    DELETED_DIRS=0
    NOT_FOUND=0
    
    while IFS= read -r path; do
        if [ -n "$path" ]; then
            delete_item "$path"
            RESULT=$?
            
            if [ $RESULT -eq 1 ]; then
                DELETED_FILES=$((DELETED_FILES + 1))
                ui_print "  [DELETED] $path"
            elif [ $RESULT -eq 2 ]; then
                DELETED_DIRS=$((DELETED_DIRS + 1))
                ui_print "  [DELETED] $path/ (directory)"
            else
                NOT_FOUND=$((NOT_FOUND + 1))
                ui_print "  [NOT FOUND] $path"
            fi
        fi
    done < "/tmp/delete.list"
    
    log ""
    log "  Summary:"
    log "    Files deleted: $DELETED_FILES"
    log "    Directories deleted: $DELETED_DIRS"
    log "    Not found: $NOT_FOUND"
    
    ui_print " "
    ui_print "  Summary:"
    ui_print "    Files deleted: $DELETED_FILES"
    ui_print "    Directories deleted: $DELETED_DIRS"
    if [ $NOT_FOUND -gt 0 ]; then
        ui_print "    Not found: $NOT_FOUND"
    fi
else
    log "  Nothing to remove"
    ui_print "  Nothing to remove"
fi

log ""
log "Step 5/6: Extracting and restoring VANILLA files"
ui_print " "
ui_print "Step 5/6: Extracting and restoring VANILLA files"

cd $TMPDIR
unzip -o "$ZIPFILE" 'system/*' 'system_ext/*' 'product/*' -d . > /dev/null 2>&1

for dir in system system_ext product; do
    if [ -d "$dir" ]; then
        COUNT=$(find $dir -type f 2>/dev/null | wc -l)
        log "  $dir/: $COUNT files to restore"
        ui_print "  $dir/: $COUNT files to restore"
    fi
done

TOTAL_RESTORED=0
TOTAL_FAILED=0

for dir in system system_ext product; do
    if [ -d "$TMPDIR/$dir" ]; then
        case $dir in
            system) MOUNT_POINT="$FOUND_SYSTEM" ;;
            system_ext) MOUNT_POINT="$FOUND_SYSTEM_EXT" ;;
            product) MOUNT_POINT="$FOUND_PRODUCT" ;;
        esac
        
        if [ -z "$MOUNT_POINT" ]; then
            log "  Skipping $dir: no mount point"
            continue
        fi
        
        RESTORED=0
        FAILED=0
        
        log "  -> Restoring $dir to $MOUNT_POINT..."
        ui_print "  -> Restoring $dir..."
        
        cd "$TMPDIR/$dir"
        find . -type f | while IFS= read -r file; do
            TARGET="$MOUNT_POINT/${file#./}"
            TARGET_DIR=$(dirname "$TARGET")
            mkdir -p "$TARGET_DIR"
            if cp -f "$file" "$TARGET"; then
                chmod --reference="$file" "$TARGET" 2>/dev/null || chmod 644 "$TARGET"
                log "    + ${file#./}"
                echo "RESTORED" >> /tmp/restore_status.txt
            else
                log "    FAILED: ${file#./}"
                echo "FAILED" >> /tmp/restore_status.txt
            fi
        done
        
        if [ -f /tmp/restore_status.txt ]; then
            RESTORED=$(grep -c 'RESTORED' /tmp/restore_status.txt)
            FAILED=$(grep -c 'FAILED' /tmp/restore_status.txt)
            TOTAL_RESTORED=$((TOTAL_RESTORED + RESTORED))
            TOTAL_FAILED=$((TOTAL_FAILED + FAILED))
            rm -f /tmp/restore_status.txt
        fi
        
        log "    $dir: $RESTORED restored, $FAILED failed"
        ui_print "    $dir: $RESTORED restored"
        if [ $FAILED -gt 0 ]; then
            ui_print "    $dir: $FAILED FAILED!"
        fi
    fi
done

log ""
log "Step 6/6: Cleanup"
ui_print " "
ui_print "Step 6/6: Cleanup"

rm -rf /tmp/gapps_to_vanilla /tmp/delete.list /tmp/restore_status.txt

log ""
log "========================================="
log "Installation complete!"
log "  Files restored: $TOTAL_RESTORED"
log "  Files failed: $TOTAL_FAILED"
log "  GAPPS items deleted: $((DELETED_FILES + DELETED_DIRS))"
log "  Not found: $NOT_FOUND"
log "Finished: $(date)"
log "========================================="

ui_print " "
ui_print "========================================="
ui_print "Installation complete!"
ui_print " "
ui_print "GAPPS removed, VANILLA AOSP restored"
ui_print " "
ui_print "Log saved: /tmp/gapps-to-vanilla.log"
ui_print "========================================="
ui_print " "

exit 0
