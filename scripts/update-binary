#!/sbin/sh
#
# gapps-to-vanilla
# Remove GAPPS and restore AOSP files
#

OUTFD=$2
ZIPFILE=$3

ui_print() {
    echo -n -e "ui_print $1\n" >> /proc/self/fd/$OUTFD
    echo -n -e "ui_print\n" >> /proc/self/fd/$OUTFD
}

abort() {
    ui_print " "
    ui_print "ERROR: $1"
    ui_print " "
    ui_print "Installation aborted"
    exit 1
}

ui_print "========================================="
ui_print "   gapps-to-vanilla"
ui_print "   Remove GAPPS and restore AOSP"
ui_print "========================================="
ui_print " "

SYSTEM_MOUNT="/system"
PRODUCT_MOUNT="/product"
SYSTEM_EXT_MOUNT="/system_ext"

ui_print "Step 1/6: Mounting partitions"
for point in $SYSTEM_MOUNT $PRODUCT_MOUNT $SYSTEM_EXT_MOUNT; do
    ui_print "  -> $point"
    
    if mount | grep -q " $point "; then
        mount -o remount,rw $point 2>/dev/null
    else
        mount -o rw $point 2>/dev/null
    fi
    
    if ! touch $point/.test 2>/dev/null; then
        mount -o rw,remount $point 2>/dev/null
        if ! touch $point/.test 2>/dev/null; then
            abort "Failed to mount $point as RW"
        fi
    fi
    rm -f $point/.test
    ui_print "    [OK] $point mounted"
done

ui_print " "
ui_print "Step 2/6: Checking free space"
for point in $SYSTEM_MOUNT $PRODUCT_MOUNT $SYSTEM_EXT_MOUNT; do
    FREE=$(df -k $point | tail -1 | awk '{print $4}')
    ui_print "  -> $point: ${FREE}KB free"
    if [ "$FREE" -lt 51200 ]; then
        ui_print "    WARNING: Low space on $point"
    fi
done

ui_print " "
ui_print "Step 3/6: Extracting delete list from ZIP"
TMPDIR=/tmp/gapps_to_vanilla
rm -rf $TMPDIR
mkdir -p $TMPDIR
cd $TMPDIR

# Extract only delete.list first
unzip -o "$ZIPFILE" 'delete.list' -d . > /dev/null 2>&1
if [ -f "delete.list" ]; then
    cp delete.list /tmp/delete.list
    DELETE_COUNT=$(wc -l < /tmp/delete.list)
    ui_print "  Found $DELETE_COUNT items to remove"
else
    touch /tmp/delete.list
    ui_print "  No items to remove"
fi

ui_print " "
ui_print "Step 4/6: Removing GAPPS files"
if [ -s "/tmp/delete.list" ]; then
    DELETED=0
    while IFS= read -r path; do
        if [ -n "$path" ]; then
            if [ -f "$path" ]; then
                rm -f "$path"
                DELETED=$((DELETED + 1))
            elif [ -d "$path" ]; then
                rm -rf "$path"
                DELETED=$((DELETED + 1))
            fi
        fi
    done < "/tmp/delete.list"
    ui_print "  Removed $DELETED items"
else
    ui_print "  Nothing to remove"
fi

ui_print " "
ui_print "Step 5/6: Extracting and restoring VANILLA files"
cd $TMPDIR

# Extract only system, system_ext, product from ZIP
unzip -o "$ZIPFILE" 'system/*' 'system_ext/*' 'product/*' -d . > /dev/null 2>&1
EXTRACT_COUNT=$(find system system_ext product -type f 2>/dev/null | wc -l)
ui_print "  Extracted $EXTRACT_COUNT files"

for dir in system system_ext product; do
    if [ -d "$TMPDIR/$dir" ]; then
        MOUNT_POINT="/$dir"
        ui_print "  -> Restoring $dir..."
        cd "$TMPDIR/$dir"
        find . -type f | while IFS= read -r file; do
            TARGET="$MOUNT_POINT/${file#./}"
            TARGET_DIR=$(dirname "$TARGET")
            mkdir -p "$TARGET_DIR"
            cp -f "$file" "$TARGET"
            chmod --reference="$file" "$TARGET" 2>/dev/null || chmod 644 "$TARGET"
        done
        ui_print "    $dir restored"
    fi
done

ui_print " "
ui_print "Step 6/6: Cleanup"
rm -rf /tmp/gapps_to_vanilla /tmp/delete.list

ui_print " "
ui_print "========================================="
ui_print "Installation complete!"
ui_print " "
ui_print "GAPPS removed, VANILLA AOSP restored"
ui_print "Please reboot system"
ui_print "========================================="
ui_print " "

exit 0
